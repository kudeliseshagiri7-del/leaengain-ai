# Copy this file to .env and enter your own Supabase project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# IMPORTANT: Never put Ollama API keys or Supabase service-role keys in this file.
# Add OLLAMA_API_KEY as a Supabase Edge Function secret instead.
